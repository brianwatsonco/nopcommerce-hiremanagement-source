<form asp-controller="HireManagement" asp-action="Configure" method="post" id="entry-form">
    <input asp-for="ProductId" type="hidden" />
    <input asp-for="ProductSearchTerm" type="hidden" />
    <input asp-for="Year" type="hidden" />
    <input asp-for="Month" type="hidden" />

    <section class="content">
        <div class="cards-group">
            <div class="card card-default no-margin">
                <div class="card-header">@T("Plugins.Misc.HireManagement.ManageEntry")</div>
                <div class="card-body">
                    @if (Model.ProductId <= 0)
                    {
                        <div class="alert alert-warning">
                            Select a product and load the diary before managing booking/unavailability records.
                        </div>
                    }
                    else
                    {
                        @if (Model.IsSurchargeReviewRequired)
                        {
                            <div class="alert alert-warning">@Model.SurchargeReviewNote</div>
                        }
                        <div class="form-group row">
                            <div class="col-md-3">
                                <label>@T("Plugins.Misc.HireManagement.Product")</label>
                            </div>
                            <div class="col-md-9">
                                <input class="form-control" value="@($"{Model.ProductName} ({Model.ProductId})")" readonly />
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="RecordId" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="RecordId" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="StatusId" />
                            </div>
                            <div class="col-md-9">
                                <nop-select asp-for="StatusId" asp-items="Model.AvailableStatuses" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="StartUtc" />
                            </div>
                            <div class="col-md-9">
                                <input asp-for="StartUtc" class="form-control" type="datetime-local" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="EndUtc" />
                            </div>
                            <div class="col-md-9">
                                <input asp-for="EndUtc" class="form-control" type="datetime-local" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="CustomerId" />
                            </div>
                            <div class="col-md-3">
                                <nop-editor asp-for="CustomerId" />
                            </div>
                            <div class="col-md-3">
                                <nop-label asp-for="OrderId" />
                            </div>
                            <div class="col-md-3">
                                <nop-editor asp-for="OrderId" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="OrderItemId" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="OrderItemId" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="PaidAmount" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="PaidAmount" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="Quantity" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="Quantity" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="AdminNote" />
                            </div>
                            <div class="col-md-9">
                                <nop-textarea asp-for="AdminNote" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-9 offset-md-3">
                                <button type="submit" name="save-record" class="btn btn-primary">@T("Plugins.Misc.HireManagement.Actions.SaveRecord")</button>
                                <button type="submit" name="delete-record" class="btn btn-danger" formnovalidate>@T("Plugins.Misc.HireManagement.Actions.DeleteRecord")</button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @if (Model.ExistingRecords.Any())
            {
                <div class="card card-default no-margin">
                    <div class="card-header">@T("Plugins.Misc.HireManagement.ExistingRecords")</div>
                    <div class="card-body">
                        <table class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>@T("Admin.Common.Edit")</th>
                                    <th>@T("Plugins.Misc.HireManagement.Fields.RecordId")</th>
                                    <th>@T("Plugins.Misc.HireManagement.Fields.Status")</th>
                                    <th>@T("Plugins.Misc.HireManagement.Fields.StartUtc")</th>
                                    <th>@T("Plugins.Misc.HireManagement.Fields.EndUtc")</th>
                                    <th>@T("Plugins.Misc.HireManagement.Fields.Customer")</th>
                                    <th>@T("Plugins.Misc.HireManagement.Fields.OrderId")</th>
                                    <th>@T("Plugins.Misc.HireManagement.Fields.OrderItemId")</th>
                                    <th>@T("Plugins.Misc.HireManagement.Fields.PaidAmount")</th>
                                    <th>@T("Plugins.Misc.HireManagement.Fields.Quantity")</th>
                                    <th>@T("Plugins.Misc.HireManagement.Fields.SurchargeReview")</th>
                                    <th>@T("Plugins.Misc.HireManagement.Fields.AdminNote")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.ExistingRecords)
                                {
                                    <tr>
                                        <td>
                                            <a class="btn btn-default"
                                               asp-controller="HireManagement"
                                               asp-action="EditRecord"
                                               asp-route-recordId="@row.Id"
                                               asp-route-productId="@Model.ProductId"
                                               asp-route-year="@Model.Year"
                                               asp-route-month="@Model.Month"
                                               asp-route-productSearchTerm="@Model.ProductSearchTerm">
                                                @T("Admin.Common.Edit")
                                            </a>
                                        </td>
                                        <td>@row.Id</td>
                                        <td>@row.Status</td>
                                        <td>@row.StartUtc</td>
                                        <td>@row.EndUtc</td>
                                        <td>@row.CustomerId (@row.CustomerEmail)</td>
                                        <td>@row.OrderId</td>
                                        <td>@row.OrderItemId</td>
                                        <td>@row.PaidAmount</td>
                                        <td>
                                            @if (row.IsSurchargeReviewRequired)
                                            {
                                                <span class="badge badge-warning">@T("Plugins.Misc.HireManagement.Fields.SurchargeReview")</span>
                                            }
                                        </td>
                                        <td>@row.AdminNote</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </section>
</form>