using Microsoft.AspNetCore.Http;
using Nop.Core;
using Nop.Core.Domain.Catalog;
using Nop.Data;
using Nop.Services.Catalog;
using Nop.Services.Directory;
using Nop.Services.Localization;
using Nop.Services.Media;
using System.Globalization;

namespace Nop.Plugin.Misc.HireManagement.Services;

public class HireProductAttributeParser : ProductAttributeParser
{
    public HireProductAttributeParser(ICurrencyService currencyService,
        IDownloadService downloadService,
        ILocalizationService localizationService,
        IProductAttributeService productAttributeService,
        IRepository<ProductAttributeValue> productAttributeValueRepository,
        IWorkContext workContext)
        : base(currencyService,
              downloadService,
              localizationService,
              productAttributeService,
              productAttributeValueRepository,
              workContext)
    {
    }

    public override void ParseRentalDates(Product product, IFormCollection form, out DateTime? startDate, out DateTime? endDate)
    {
        startDate = null;
        endDate = null;

        if (!product.IsRental)
            return;

        var startDateTimeValue = form[$"rental_start_datetime_{product.Id}"].ToString();
        var endDateTimeValue = form[$"rental_end_datetime_{product.Id}"].ToString();

        if (TryParseDateTime(startDateTimeValue, out var parsedStart))
            startDate = DateTime.SpecifyKind(parsedStart, DateTimeKind.Unspecified);

        if (TryParseDateTime(endDateTimeValue, out var parsedEnd))
            endDate = DateTime.SpecifyKind(parsedEnd, DateTimeKind.Unspecified);

        if (startDate.HasValue && endDate.HasValue)
            return;

        base.ParseRentalDates(product, form, out var fallbackStartDate, out var fallbackEndDate);
        startDate ??= fallbackStartDate;
        endDate ??= fallbackEndDate;
    }

    public override async Task<string> ParseProductAttributesAsync(Product product, IFormCollection form, List<string> errors)
    {
        var attributesXml = await base.ParseProductAttributesAsync(product, form, errors);

        if (!product.IsRental || string.IsNullOrEmpty(attributesXml))
            return attributesXml;

        var mappings = await _productAttributeService.GetProductAttributeMappingsByProductIdAsync(product.Id);
        foreach (var mapping in mappings)
        {
            if (!await IsDurationAttributeMappingAsync(mapping))
                continue;

            attributesXml = RemoveProductAttribute(attributesXml, mapping);
        }

        return attributesXml;
    }

    private async Task<bool> IsDurationAttributeMappingAsync(ProductAttributeMapping mapping)
    {
        if (mapping == null)
            return false;

        if (ContainsDurationKeyword(mapping.TextPrompt))
            return true;

        var attribute = await _productAttributeService.GetProductAttributeByIdAsync(mapping.ProductAttributeId);
        return ContainsDurationKeyword(attribute?.Name);
    }

    private static bool ContainsDurationKeyword(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return false;

        var normalized = value.Trim().ToLowerInvariant();

        return normalized.Contains("number of days", StringComparison.Ordinal)
               || normalized.Contains("number of day", StringComparison.Ordinal)
               || normalized.Contains("duration", StringComparison.Ordinal)
               || normalized.Equals("days", StringComparison.Ordinal)
               || normalized.Equals("day", StringComparison.Ordinal)
               || normalized.EndsWith(" days", StringComparison.Ordinal)
               || normalized.EndsWith(" day", StringComparison.Ordinal);
    }

    private static bool TryParseDateTime(string value, out DateTime parsedDate)
    {
        return DateTime.TryParseExact(value,
                   ["yyyy-MM-ddTHH:mm", "yyyy-MM-ddTHH:mm:ss"],
                   CultureInfo.InvariantCulture,
                   DateTimeStyles.None,
                   out parsedDate)
               || DateTime.TryParse(value, CultureInfo.CurrentCulture, DateTimeStyles.None, out parsedDate)
               || DateTime.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.None, out parsedDate);
    }
}
